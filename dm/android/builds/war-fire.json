  "title": {"de": "Feuer-Hexenmeister", "en": "Fire Warlock"},
  "summary": {
    "de": "Chaos-Baum: Feuerring, Flammenwelle und Apokalypse stärken sich gegenseitig. Früh stark und billig auszurüsten, später mit Rätsel und Ars Al'Diabolos. Ohne Umskillen von Stufe 1 bis zum Endgame.",
    "en": "Chaos tree: Ring of Fire, Flame Wave and Apocalypse boost each other. Strong early and cheap to gear, later with Enigma and Ars Al'Diabolos. No respec needed from level 1 to the endgame."
  },
  "overview": {
    "strengths": {
      "de": ["Große Flächen mit Feuer, gut für Gruppen und Horden", "Kommt mit Runenwörtern aus dem Normal-Modus gut durch", "Kein Umskillen nötig; nur die 4 Startpunkte bleiben liegen"],
      "en": ["Large areas of fire, good against groups and packs", "Gets through Normal well with early rune words", "No respec needed; only the 4 starting points stay unused"]
    },
    "weaknesses": {
      "de": ["Feuer-immune Gegner in der Hölle brauchen Söldner-Aura oder Feuer-Brecher-Zauber", "Endgame-Schuhe und Nebenhand brauchen viel Stärke", "Patch 3.2 hat Feuerring und Flammenwelle leicht abgeschwächt"],
      "en": ["Fire-immune monsters in Hell need the mercenary's aura or a fire sunder charm", "Endgame boots and off-hand need a lot of strength", "Patch 3.2 slightly weakened Ring of Fire and Flame Wave"]
    },
    "notes": {
      "de": ["Apokalypse ab Stufe 30: einen Punkt aus Stufe 29 dafür aufheben", "Der Plan zählt nur Basispunkte, +Fertigkeiten von Gegenständen zählen nicht", "Ab Patch 3.2 geht ein Zweihand-Stab zusammen mit einem Grimoire", "Andere Variante (Odealo, Game Rant): Verzehrung auf einem Besudelten statt Bluteid", "Etwa 7 Punkte bis Stufe 99 bleiben frei"],
      "en": ["Apocalypse from level 30: keep one point from level 29 for it", "The plan counts base points only, +skills from items do not count", "Since patch 3.2 a two-handed staff can be used together with a grimoire", "Other variant (Odealo, Game Rant): Consume on a Tainted instead of Blood Oath", "About 7 points stay free by level 99"]
    }
  },

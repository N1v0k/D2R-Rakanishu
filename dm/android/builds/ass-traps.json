  "title": {"de": "Blitzfallen-Assassine (Trapsin)", "en": "Lightning Trap Assassin (Trapsin)"},
  "summary": {
    "de": "Fallen-Baum: Blitzwächter schießen durchschlagende Blitze, Todeswächter sprengen Leichen. Leveln mit Feuerbombe und Feuerwelle, mit 38 Umskillen auf Fallen; im Endgame fünf Fallen auf 20 und ein Söldner mit Unendlichkeit.",
    "en": "Traps tree: Lightning Sentries fire piercing bolts, Death Sentries blow up corpses. Level with Fire Blast and Wake of Fire, respec to traps at 38; in the endgame five traps at 20 and a mercenary with Infinity."
  },
  "overview": {
    "strengths": {
      "de": ["Sicher: Fallen kämpfen auf Abstand, Gedankenschlag und Schattenmantel halten Gegner fern", "Blitz, Feuer und Kadaverexplosion: drei Schadensarten", "Günstiger Einstieg mit Geist und einem Stab mit Widerstandsschwund-Ladungen"],
      "en": ["Safe: traps fight at range, Mind Blast and Cloak of Shadows keep enemies away", "Lightning, fire and corpse explosions: three damage types", "Cheap start with Spirit and a wand with Lower Resist charges"]
    },
    "weaknesses": {
      "de": ["Ohne Unendlichkeit oder Himmelsriss langsam gegen Blitz-Immune; Feuerbombe hilft", "Schaden baut sich langsam auf; frühe Akt-Bosse sind zäh", "Teures Endgame: Unendlichkeit, Greifenauge, Rätsel"],
      "en": ["Slow against lightning immunes without Infinity or Crack of the Heavens; Fire Blast helps", "Damage builds up slowly; early act bosses take a while", "Expensive endgame: Infinity, Griffon's Eye, Enigma"]
    },
    "notes": {
      "de": ["Leveln und Umskillen mit 38 nach Maxroll; GIGA skillt schon ab 32 im Albtraum um", "Ohne Umskillen (Gamer Guides, 2.4): Schocknetz, Comboblitzwächter, ab 24 Blitzwächter", "Fallen legen nutzt Angriffstempo (Temposchub); Zaubertempo hilft beim Teleport", "Hauptquellen Stand 3.2, GIGA von 2021; laut Patchnotes ändern 3.2 und 3.3 die Assassine nicht"],
      "en": ["Leveling and the respec at 38 after Maxroll; GIGA respecs from 32 in Nightmare", "No respec (Gamer Guides, 2.4): Shock Web, Charged Bolt Sentry, Lightning Sentry from 24", "Laying traps uses attack speed (Burst of Speed); cast rate helps Teleport", "Main sources as of 3.2, GIGA from 2021; per the patch notes 3.2 and 3.3 do not change the Assassin"]
    }
  },

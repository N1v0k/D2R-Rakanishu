  "summary": {
    "de": "Dämon-Baum: bis zu drei Dämonen kämpfen für dich, einer davon ein gebundener Elite-Gegner mit seinen Eigenschaften. Dämonenbeherrschung stärkt alle, Todeszeichen lenkt sie, Mästen heilt sie. Sicher, ruhig zu spielen, braucht wenig Ausrüstung.",
    "en": "Demon tree: up to three demons fight for you, one of them a bound elite monster that keeps its affixes. Demonic Mastery strengthens them all, Death Mark directs them, Engorge heals them. Safe, calm to play, needs little gear."
  },
  "overview": {
    "strengths": {
      "de": ["Sicher und ruhig: die Dämonen halten die Gegner fern", "Wenig Ausrüstung nötig, guter Start in die Hölle", "Gebundener Dämon behält seine Eigenschaften und Aura"],
      "en": ["Safe and calm: the demons keep enemies away", "Needs little gear, a good start into Hell", "The bound demon keeps its affixes and aura"]
    },
    "weaknesses": {
      "de": ["Hängt am Verhalten der Dämonen, wenig Flächenschaden", "Physisch-immune Gegner brauchen Fluch, Unendlichkeit oder Knochenbruch-Zauber", "Spieler berichten von deutlich weniger Schaden durch Dämon binden in 3.3 (keine offizielle Zahl)"],
      "en": ["Depends on how the demons behave, little area damage", "Physical immunes need a curse, Infinity or a Bone Break sunder charm", "Players report much less Bind Demon damage in 3.3 (no official figure)"]
    },
    "notes": {
      "de": ["Dämonenbeherrschung: zweiter Dämon ab 5, dritter ab 10 Punkten; nur echte Punkte zählen", "Dämon binden braucht 10 / 15 / 20 echte Punkte für Champions / Unikate / Superunikate", "Ziel laut Maxroll: verfluchter Dunkler Lanzer mit Aura (Ancient's Way), einfacher Lister", "Leveln ist unsere Anpassung; Endgame nach Maxroll. Forums-Variante: Entweiher 20, Mästen 10", "Etwa 1 Punkt bis Stufe 99 bleibt frei"],
      "en": ["Demonic Mastery: second demon from 5, third from 10 points; only real points count", "Bind Demon needs 10 / 15 / 20 real points for champions / uniques / super uniques", "Target per Maxroll: a cursed Dark Lancer with an aura (Ancient's Way), Lister is easier", "Leveling is our adaptation; endgame after Maxroll. Forum variant: Defiler 20, Engorge 10", "About 1 point stays free by level 99"]
    }
  },

  "summary": {
    "de": "Kältebaum: Blizzard für Flächen, Gletschernadel und Eisstoß für Gruppen und Bosse, Teleport für schnelle Läufe. Leveln mit Nova wie bei Maxroll, mit 26 auf Kälte umskillen. Billig zu starten und beliebt zum Farmen mit Magic Find.",
    "en": "Cold tree: Blizzard for areas, Glacial Spike and Ice Blast for packs and bosses, Teleport for fast runs. Level with Nova as Maxroll does, respec to cold at 26. Cheap to start and popular for magic-find farming."
  },
  "overview": {
    "strengths": {
      "de": ["Blizzard deckt große Flächen ab; Kälte verlangsamt und friert Gegner ein", "Teleport von Haus aus: schnelle Läufe zu Andariel, Mephisto und Pindleskin", "Billiger Start mit Geist, Überlieferung und Verstohlenheit; gut für Magic Find"],
      "en": ["Blizzard covers large areas; cold slows and freezes monsters", "Native Teleport: fast runs to Andariel, Mephisto and Pindleskin", "Cheap start with Spirit, Lore and Stealth; good for magic find"]
    },
    "weaknesses": {
      "de": ["Kälte-Immune in der Hölle: Söldner mit Macht, Der Kältespalt oder vorbeiteleportieren", "Wenig Leben, verträgt kaum Treffer: Abstand halten und Gegner ziehen", "Braucht Stufen für schnelleres Zaubern (63 / 105 %); Blizzard hat eine Abklingzeit"],
      "en": ["Cold immunes in Hell: a Might mercenary, Cold Rupture or teleporting past them", "Low life, takes few hits: keep your distance and kite", "Needs faster cast rate breakpoints (63 / 105%); Blizzard has a cooldown"]
    },
    "notes": {
      "de": ["Mit 26 bei Akara umskillen (Maxroll); D2Runewizard levelt mit Feuer und skillt um 30 um", "Ab 51 unsere Anpassung: weiter Kälte statt Meteor (Maxroll), spart ein zweites Umskillen", "Starter-Variante (Maxroll): Kältebeherrschung gleich nach Blizzard ausbauen", "Maxroll 22.05.2026 (S14), D2Runewizard 04/2025 (vor 3.0); 3.2/3.3 ohne Zauberin-Änderung"],
      "en": ["Respec at Akara at 26 (Maxroll); D2Runewizard levels with fire and respecs near 30", "From 51 our adaptation: more cold instead of Meteor (Maxroll), saves a second respec", "Starter variant (Maxroll): raise Cold Mastery right after Blizzard", "Maxroll 2026-05-22 (S14), D2Runewizard 04/2025 (pre-3.0); no Sorceress changes in 3.2/3.3"]
    }
  },

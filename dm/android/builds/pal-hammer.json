  "summary": {
    "de": "Gesegneter Hammer mit Konzentration: Hämmer kreisen um den Paladin und machen Magieschaden. Gedeihen und Gesegnete Führung verstärken sie, Heiliger Schild schützt. Leveln mit Heiligem Feuer, ab 19 Hämmer.",
    "en": "Blessed Hammer with Concentration: hammers spiral around the Paladin and deal magic damage. Vigor and Blessed Aim boost them, Holy Shield protects. Level with Holy Fire, hammers from 19 on."
  },
  "overview": {
    "strengths": {
      "de": ["Magieschaden: kaum Immune, mehr Schaden gegen Untote und Dämonen", "Sehr zäh: Heiliger Schild und 75 % Block", "Billiger Start mit Geist, Überlieferung und Verstohlenheit; gut für Magic Find"],
      "en": ["Magic damage: almost no immunes, extra damage to undead and demons", "Very tanky: Holy Shield and 75% block", "Cheap start with Spirit, Lore and Stealth; good for magic find"]
    },
    "weaknesses": {
      "de": ["Schwach in engen Gängen: Hämmer enden an Wänden", "Magie-Immune: Niederstrecken, Söldner oder Erneuerte Schwarze Bresche", "Erst ab Stufe 18; ohne Teleport (Rätsel) schwerfällig"],
      "en": ["Weak in narrow areas: hammers stop at walls", "Magic immunes: Smite, the mercenary or a Renewed Black Cleft", "Only from level 18; clunky without Teleport (Enigma)"]
    },
    "notes": {
      "de": ["Maxroll: Heiliges Feuer bis 18, mit 19 bei Akara umskillen auf Hämmer", "Mit 75 erneut umskillen (unsere Lesart): Geschick bis 75 % Block; ~125 nur Beispiel (Stufe 84, Herold)", "Heiliger Schild ab 24 ist unsere Anpassung (Gamer Guides); Maxroll levelt ohne ihn", "3.2/3.3 ändern den Paladin nicht; Gamer Guides, D2Runewizard, Mein-MMO sind älter (Rest in Heiliger Schild)"],
      "en": ["Maxroll: Holy Fire to 18, respec to hammers at Akara at 19", "Respec again at 75 (our reading): dexterity for 75% block; ~125 is only an example (level 84, Herald)", "Holy Shield from 24 is our adaptation (Gamer Guides); Maxroll levels without it", "3.2/3.3 do not change the Paladin; Gamer Guides, D2Runewizard, Mein-MMO are older (rest into Holy Shield)"]
    }
  },

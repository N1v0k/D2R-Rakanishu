  "title": {"de": "Feuerwellen-Assassine (Feuerfallen)", "en": "Wake of Fire Assassin (fire traps)"},
  "summary": {
    "de": "Fallen-Baum mit Feuer: fünf Feuerwellen schießen durchschlagende Feuerwogen, Feuerbombe hilft aktiv, Todeswächter sprengen Leichen. Ohne Umskillen von Stufe 1 bis 99; Blitzwächter und ein Söldner mit Unendlichkeit gegen Feuer-Immune.",
    "en": "Traps tree with fire: five Wake of Fire traps shoot piercing fire waves, Fire Blast helps actively, Death Sentries blow up corpses. No respec from level 1 to 99; Lightning Sentry and a mercenary with Infinity for fire immunes."
  },
  "overview": {
    "strengths": {
      "de": ["Sicher: Fallen kämpfen auf Abstand", "Einsteigerfreundlich und günstig; starke Gebiete mit vielen Gegnern", "Schnell: Temposchub, später Teleport", "Gut für Magic Find"],
      "en": ["Safe: traps fight at range", "Beginner friendly and cheap; strong in dense areas", "Fast: Burst of Speed, later Teleport", "Good for magic find"]
    },
    "weaknesses": {
      "de": ["Feuer-Immune in der Hölle: Todeswächter, Blitzwächter, Söldner nötig", "Schaden baut sich langsam auf; Akt-Bosse früh zäh", "Volle Stärke erst mit Unendlichkeit beim Söldner"],
      "en": ["Fire immunes in Hell: needs Death Sentry, Lightning Sentry, mercenary", "Damage builds up slowly; act bosses take a while early on", "Full power only with Infinity on the mercenary"]
    },
    "notes": {
      "de": ["Leveln bis 37 nach Maxroll (an unsere Quest-Annahme angepasst); danach wie DiabloBytes Feuer statt Umskillen mit 38", "Maxroll-Reihenfolge: Feuerwelle, Feuerbombe, Infernowoge, Todeswächter, Blitzwächter", "Temposchub bleibt bei 5 aus dem Leveln (Maxroll: 1); dafür weniger Blitzwächter", "Der Flammenspalt setzt Feuer-Immune auf 95 %; Verurteilung und Widerstandsschwund senken weiter", "Quellen Stand 3.2; laut 3.3-Patchnotes keine Änderung an der Assassine"],
      "en": ["Leveling to 37 after Maxroll (fitted to our quest assumption); then fire like DiabloBytes instead of the respec at 38", "Maxroll order: Wake of Fire, Fire Blast, Wake of Inferno, Death Sentry, Lightning Sentry", "Burst of Speed stays at 5 from leveling (Maxroll: 1); Lightning Sentry gets fewer points", "Flame Rift sets fire immunes to 95%; Conviction and Lower Resist lower it further", "Sources as of 3.2; per the 3.3 patch notes no change to the Assassin"]
    }
  },

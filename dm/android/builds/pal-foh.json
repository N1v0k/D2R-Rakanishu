  "title": {"de": "Himmelsfaust-Paladin (FoHdin)", "en": "Fist of the Heavens Paladin (FoHdin)"},
  "summary": {
    "de": "Himmelsfaust trifft ein Ziel mit Blitz und verstreut Heilige Blitze gegen Untote und Dämonen; Verurteilung bricht Blitz-Immunität. Gezielter Elite-Jäger mit großer Reichweite. Leveln mit Heiligem Feuer, mit 30 umskillen, mit 75 neu verteilen.",
    "en": "Fist of the Heavens hits one target with lightning and scatters Holy Bolts against undead and demons; Conviction breaks lightning immunity. A long-range elite sniper. Level with Holy Fire, respec at 30, redistribute at 75."
  },
  "overview": {
    "strengths": {
      "de": ["Große Reichweite: Elite-Gruppen gezielt ausschalten", "Verurteilung bricht fast jede Blitz-Immunität", "Heilige Blitze säubern Untote und Dämonen, auch Magie-Immune", "Gut für Magic Find; hoher Block mit Heiligem Schild"],
      "en": ["Long range: take out elite packs on purpose", "Conviction breaks almost every lightning immunity", "Holy Bolts clear undead and demons, magic immunes too", "Good for magic find; high block with Holy Shield"]
    },
    "weaknesses": {
      "de": ["Himmelsfaust hat eine Abklingzeit: viele Klicks", "Tiere mit unbrechbarer Blitz-Immunität nur über den Söldner", "Braucht schnelles Zaubern (75 %, später 125 %)"],
      "en": ["Fist of the Heavens has a cooldown: many clicks", "Animals with unbreakable lightning immunity only via the mercenary", "Needs faster cast rate (75%, later 125%)"]
    },
    "notes": {
      "de": ["Bis 18 Maxroll-Leveln; Umskillen mit 30 und Heiliges Feuer bis 29 nach DiabloBytes", "Maxroll geht erst mit 75 auf Himmelsfaust (über Hämmer)", "Gegen unbrechbar Blitz-Immune (ab 75) Fanatismus an, Söldner kämpfen lassen", "Verurteilung nur bis Wirkstufe 25 (stärkste Senkung); Ausrüstung und Kampfaufruf zählen mit", "Blitz- und Feuer-Widerstand immer paarweise: 2 Punkte = 1 % mehr Höchstwert", "Quellen Stand 3.2; laut 3.3-Patchnotes keine Änderung am Paladin"],
      "en": ["Maxroll leveling to 18; respec at 30 and Holy Fire to 29 after DiabloBytes", "Maxroll switches to Fist of the Heavens only at 75 (via hammers)", "Against unbreakable lightning immunes (from 75) use Fanaticism, let the mercenary fight", "Conviction only up to effective level 25 (largest reduction); gear and Battle Command count", "Fire and lightning resist always in pairs: 2 points = 1% higher maximum", "Sources as of 3.2; per the 3.3 patch notes no change to the Paladin"]
    }
  },

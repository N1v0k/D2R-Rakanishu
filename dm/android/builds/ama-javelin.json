  "title": {"de": "Blitz-Wurfspieß-Amazone (Javazon)", "en": "Lightning Javelin Amazon (Javazon)"},
  "summary": {
    "de": "Blitzendes Unheil für Gruppen, Geladener Schlag für Bosse; Kettenblitzschlag, Energieschlag und Blitzschlag als Synergien. Leveln ohne Umskillen: ab 18 Geladener Schlag, ab 30 Blitzendes Unheil. Ziel: Titans Rache, Greifenauge, Söldner mit Unendlichkeit.",
    "en": "Lightning Fury for packs, Charged Strike for bosses; Lightning Strike, Power Strike and Lightning Bolt as synergies. Leveling without a respec: Charged Strike from 18, Lightning Fury from 30. Goal: Titan's Revenge, Griffon's Eye, an Infinity mercenary."
  },
  "overview": {
    "strengths": {
      "de": ["Blitzendes Unheil räumt dichte Gruppen, sehr stark im geheimen Kuhlevel", "Geladener Schlag gehört zu den stärksten Boss-Killern (Baal, Diablo)", "Leicht zu spielen und schafft alle späten Inhalte"],
      "en": ["Lightning Fury clears dense packs, very strong in the Secret Cow Level", "Charged Strike is one of the best boss killers (Baal, Diablo)", "Easy to play and clears all late-game content"]
    },
    "weaknesses": {
      "de": ["Blitz-Immune in der Hölle: vor Unendlichkeit Zauber, Fluch, Stoß oder umgehen", "Volle Stärke nur mit teurer Ausrüstung (Greifenauge, Rätsel, Unendlichkeit)", "Langsamer Start: vor Stufe 18 wenig gegen Gruppen"],
      "en": ["Lightning immunes in Hell: before Infinity a sunder charm, curse, Jab or skipping", "Full power only with expensive gear (Griffon's Eye, Enigma, Infinity)", "Slow start: little against packs before level 18"]
    },
    "notes": {
      "de": ["Leveln nach Gamer Guides ohne Umskillen; Maxroll levelt mit Bogen und skillt mit 38 um", "Gegen Blitz-Immune: Unendlichkeit (die meisten) oder Himmelsriss-Zauber; Donnerschlag hilft erst danach", "Angriffstempo für Blitzendes Unheil: 52 % ideal, mindestens 30 %, je nach Waffe (Maxroll)", "Gamer Guides ist von 2023; Patchnotes 3.2 und 3.3 ändern keine Amazonen-Fertigkeit"],
      "en": ["Leveling after Gamer Guides without a respec; Maxroll levels with a bow, respecs at 38", "Against lightning immunes: Infinity (most of them) or a Crack of the Heavens charm; Thunderstroke helps after that", "Attack speed for Lightning Fury: 52% ideal, at least 30%, depending on the weapon (Maxroll)", "Gamer Guides dates from 2023; patch notes 3.2 and 3.3 change no Amazon skill"]
    }
  },
